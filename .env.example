# === required ===
# key from https://ollama.com/settings/keys
OLLAMA_API_KEY=

# === autogenerated on first run (left empty here on purpose) ===
# AUTH_PASSWORD=    # login password for the single user
# SECRET_KEY=       # signing key for the auth cookie

# === optional (defaults shown) ===
# OLLAMA_BASE_URL=https://ollama.com
# APP_PORT=8000
# DEFAULT_MODEL=
# COOKIE_SECURE=false      # true behind HTTPS in production

# TOOL_MAX_ITER=8          # max upstream calls per turn (tool loop)
# TOOL_RESULT_MAX_CHARS=20000
# HISTORY_MAX_MESSAGES=40
# NOTES_SNAPSHOT_CHARS=500 # notes snapshot in the system prompt

# PYEXEC_TIMEOUT=8         # python tool execution timeout, seconds
# PYEXEC_NETWORK=true      # false = run the python tool without network (unshare)