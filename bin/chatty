#!/usr/bin/env bash
# chatty — selfhost chat in one command, from anywhere in the shell.
#
#   chatty            start the server in the background and open the browser
#                     (if one is already running it does not start a second — it just opens a tab)
#   chatty fg         the same, but in the current terminal (Ctrl+C stops it)
#   chatty dev        dev mode: uvicorn + vite dev server (Ctrl+C stops it)
#   chatty stop       stop the running server
#   chatty restart    stop + start
#   chatty status     what is running, and on which port
#   chatty logs       tail the background server's log (tail -f)
#   chatty install    put itself on PATH (~/.local/bin/chatty)
#
# Variables: CHATTY_DIR (project directory), CHATTY_NO_OPEN=1 (do not open the browser),
#            CHATTY_WAIT=<sec> (how long to wait for startup, 300 by default).
set -euo pipefail

# --- where the project is: this file may be a symlink from ~/.local/bin ---
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
ROOT=${CHATTY_DIR:-$(cd -P "$(dirname "$src")/.." && pwd)}

RUN_DIR="$ROOT/.run"
PID_FILE="$RUN_DIR/chatty.pid"
LOG_FILE="$RUN_DIR/chatty.log"
URL_FILE="$RUN_DIR/chatty.url"

usage() {
  awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$src"
}

# port preference: .env -> 8000 (same as run.sh)
env_port() {
  local p=""
  [ -f "$ROOT/.env" ] && p=$(grep -E '^APP_PORT=' "$ROOT/.env" | head -1 | cut -d= -f2- | tr -d ' "')
  printf '%s' "${p:-8000}"
}

# first free port starting at $1 (IPv4+IPv6, like port_free in run.sh)
free_port() {
  python3 - "$1" <<'PY'
import errno, socket, sys

start = int(sys.argv[1])

def is_free(port: int) -> bool:
    for fam, addr in ((socket.AF_INET, "0.0.0.0"), (socket.AF_INET6, "::")):
        s = socket.socket(fam)
        try:
            s.bind((addr, port))
        except OSError as e:
            if e.errno in (errno.EAFNOSUPPORT, errno.EADDRNOTAVAIL):
                continue          # family unsupported on this host — ignore
            return False          # address in use
        finally:
            s.close()
    return True

for p in range(start, start + 11):
    if is_free(p):
        print(p)
        raise SystemExit(0)
raise SystemExit(1)
PY
}

# pid of the background server, if it is alive and really our process
pid_from_file() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -qE 'uvicorn|run\.sh' || return 1
  printf '%s' "$pid"
}

# a running uvicorn of this project, even if we did not start it (./run.sh by hand)
# -> prints "<pid> <url>"
detect_running() {
  local pid="" port="" p cwd cmd
  if pid=$(pid_from_file); then
    printf '%s %s\n' "$pid" "$(read_url)"
    return 0
  fi
  for p in /proc/[0-9]*; do
    cwd=$(readlink "$p/cwd" 2>/dev/null) || continue
    [ "$cwd" = "$ROOT" ] || continue
    cmd=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null) || continue
    case $cmd in *"uvicorn backend.app"*) ;; *) continue ;; esac
    port=$(printf '%s\n' "$cmd" | sed -n 's/.*--port[= ]\([0-9]\{1,\}\).*/\1/p')
    printf '%s %s\n' "${p#/proc/}" "http://localhost:${port:-$(env_port)}"
    return 0
  done
  return 1
}

read_url() {
  if [ -s "$URL_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
    cat "$URL_FILE"
  else
    printf 'http://localhost:%s' "$(env_port)"
  fi
}

open_browser() {
  [ "${CHATTY_NO_OPEN:-0}" = "1" ] && return 0
  [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || return 0
  command -v xdg-open >/dev/null 2>&1 || return 0
  setsid xdg-open "$1" >/dev/null 2>&1 &
}

# wait until the port answers over http; the process dying is an immediate error
wait_ready() {
  local port=$1 waited=0 limit=${CHATTY_WAIT:-300}
  printf '[chatty] waiting for startup'
  while [ "$waited" -lt "$limit" ]; do
    if curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$port/" 2>/dev/null; then
      printf ' ready\n'
      return 0
    fi
    if ! pid_from_file >/dev/null; then
      printf '\n[ERR] the process exited, last log lines:\n' >&2
      tail -n 20 "$LOG_FILE" >&2 2>/dev/null || true
      rm -f "$PID_FILE"
      return 1
    fi
    printf '.'
    sleep 1
    waited=$((waited + 1))
  done
  printf '\n[ERR] no answer within %ss — see %s\n' "$limit" "$LOG_FILE" >&2
  return 1
}

cmd_start() {
  local pid url port
  if read -r pid url < <(detect_running); then
    echo "[chatty] already running (pid $pid) — $url"
    open_browser "$url"
    return 0
  fi

  mkdir -p "$RUN_DIR"
  rm -f "$PID_FILE"

  local want
  want=$(env_port)
  if ! port=$(free_port "$want"); then
    echo "[ERR] no free port in the range $want-$((want + 10))" >&2
    exit 1
  fi
  [ "$port" = "$want" ] || echo "[WARN] port $want is taken by another process — starting on $port" >&2

  url="http://localhost:$port"
  printf '%s\n' "$url" > "$URL_FILE"
  : > "$LOG_FILE"
  echo "[chatty] starting on $url  (log: .run/chatty.log)"

  # setsid: the server does not die with the terminal and does not catch its Ctrl+C.
  # the future process writes the pid itself — after exec that is exactly the uvicorn pid.
  setsid bash -c '
    echo $$ > "$1"; shift
    cd "$1"; shift
    export APP_PORT="$1"; shift
    exec ./run.sh >>"$1" 2>&1
  ' _ "$PID_FILE" "$ROOT" "$port" "$LOG_FILE" </dev/null >/dev/null 2>&1 &

  wait_ready "$port" || exit 1

  echo "[chatty] login password: grep '^AUTH_PASSWORD' .env"
  echo "[chatty] logs: chatty logs   stop: chatty stop"
  open_browser "$url"
}

cmd_stop() {
  local pid url
  if ! read -r pid url < <(detect_running); then
    echo "[chatty] not running"
    rm -f "$PID_FILE" "$URL_FILE"
    return 0
  fi
  echo "[chatty] stopping pid $pid ($url)"
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 50); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "[chatty] did not answer SIGTERM — SIGKILL"
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE" "$URL_FILE"
  echo "[chatty] stopped"
}

cmd_status() {
  local pid url
  if read -r pid url < <(detect_running); then
    local code
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$url/" 2>/dev/null || echo "no answer")
    echo "chatty: running (pid $pid) — $url  [http $code]"
  else
    echo "chatty: not running"
    [ -f "$LOG_FILE" ] && echo "log of the last run: $LOG_FILE"
  fi
}

cmd_install() {
  local dest="$HOME/.local/bin/chatty"
  mkdir -p "$(dirname "$dest")"
  ln -sfn "$ROOT/bin/chatty" "$dest"
  echo "[chatty] installed: $dest -> $ROOT/bin/chatty"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) echo "[chatty] $HOME/.local/bin is already on PATH — just type 'chatty'" ;;
    *) echo "[WARN] add to ~/.bashrc: export PATH=\"\$HOME/.local/bin:\$PATH\"" >&2 ;;
  esac
}

cmd=${1:-start}
shift 2>/dev/null || true

case "$cmd" in
  start)           cmd_start ;;
  fg|run)          cd "$ROOT"; exec ./run.sh "$@" ;;
  dev)             cd "$ROOT"; exec ./dev.sh "$@" ;;
  stop)            cmd_stop ;;
  restart)         cmd_stop; cmd_start ;;
  status)          cmd_status ;;
  logs)            [ -f "$LOG_FILE" ] || { echo "[chatty] no log yet ($LOG_FILE)" >&2; exit 1; }
                   exec tail -f "$LOG_FILE" ;;
  install)         cmd_install ;;
  -h|--help|help)  usage ;;
  *)               echo "[chatty] unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
